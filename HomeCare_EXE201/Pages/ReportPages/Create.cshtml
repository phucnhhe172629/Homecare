@page
@model HomeCare_EXE201.Pages.ReportPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Report</h4>
<hr />
<div class="row">
    <form class="custom-form consulting-form bg-white shadow-lg mb-5 mb-lg-0" method="post">
        <div class="consulting-form-header d-flex align-items-center">
            <h3 class="mb-4">Report Booking</h3>
        </div>
        <div class="consulting-form-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Report.BookingId" class="control-label"></label>
                <select asp-for="Report.BookingId" class="form-control" asp-items="ViewBag.BookingId" required></select>
                <span asp-validation-for="Report.BookingId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Report.Content" class="control-label"></label>
                <input asp-for="Report.Content" class="form-control" />
                <span asp-validation-for="Report.Content" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Report.Image" class="control-label"></label>
                <input asp-for="Report.Image" class="form-control" type="file" />
                <span asp-validation-for="Report.Image" class="text-danger"></span>
            </div>
            <div class="form-group col-lg-6 col-md-10 col-8 mx-auto">
                <input type="submit" value="Create" class="btn btn-primary form-control" style="color: #fff" />
            </div>
        </div>
    </form>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
